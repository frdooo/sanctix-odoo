<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sanctix_document_screen_wizard_form" model="ir.ui.view">
        <field name="name">sanctix.document.screen.wizard.form</field>
        <field name="model">sanctix.document.screen.wizard</field>
        <field name="arch" type="xml">
            <form string="Screen Trade Document via Sanctix">
                <sheet>
                    <div class="text-muted mb-3">
                        Attach an invoice, bill of lading, packing list or similar —
                        Sanctix reads the parties named on it and screens each one.
                        Costs max(1, parties found) screens; needs a Growth plan or above.
                    </div>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="document_filename" invisible="1"/>
                        <field name="document" filename="document_filename"/>
                        <field name="threshold"/>
                        <field name="limit"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Screen Document" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sanctix_document_screen_wizard" model="ir.actions.act_window">
        <field name="name">Screen Trade Document (Sanctix)</field>
        <field name="res_model">sanctix.document.screen.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>
</odoo>
